{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build --webpack",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/refund-expired-interviews",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/send-interview-notifications",
      "schedule": "* * * * *"
    }
  ]
}
