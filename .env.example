DATABASE_URL=

# Canonical public URL used in recruiter team invitations and workspace links.
RECRUITER_APP_URL=https://recruiter.verisnova.com

# Razorpay server credentials. Never expose RAZORPAY_KEY_SECRET to browser code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public key id only. The checkout currently receives the key id from the
# authenticated create-order response, but keep this populated for Next.js
# environment parity across DEV/PROD.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Defaults to 18 when omitted.
BILLING_GST_PERCENTAGE=18
# Keep false until your GST adviser confirms a valid LUT/bond is in force.
# When true, non-India billing is recorded as zero-rated export of services.
BILLING_EXPORT_UNDER_LUT=false
BILLING_INVOICE_BUCKET=invoices
BILLING_SUPPORT_EMAIL=support@verisnova.com

# Required by Vercel Cron. Use a long random value in Production.
CRON_SECRET=
