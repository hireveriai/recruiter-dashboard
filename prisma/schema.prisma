generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DifficultyProfile {
  JUNIOR
  MID
  SENIOR
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ORG_OWNER
  ADMIN
  SYSTEM
}

model Organization {
  organizationId   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("organization_id")
  organizationName String    @map("organization_name")
  timezone         String    @default("Asia/Kolkata")
  timezoneLabel    String    @default("India Standard Time")
  gstNumber        String?   @map("gst_number")
  billingAddress   String?   @map("billing_address")
  financeEmail     String?   @map("finance_email")
  invoiceRecipientEmail String? @map("invoice_recipient_email")
  billingCountryCode String @default("IN") @db.Char(2) @map("billing_country_code")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("organizations")
}
model JobPosition {
  jobId                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("job_id")
  organizationId        String                 @db.Uuid @map("organization_id")
  jobTitle              String                 @map("job_title")
  jobDescription        String?                @map("job_description")
  experienceLevelId     Int                    @db.SmallInt @map("experience_level_id")
  coreSkills            String[]               @map("core_skills")
  // NOTE: the underlying column is plain text, not a Postgres enum. The
  // `difficulty_profile` enum type does not exist in the database.
  difficultyProfile     String?                @map("difficulty_profile")
  interviewDurationMinutes Int                 @default(30) @map("interview_duration_minutes")
  interviewMode         String                 @default("INDIVIDUALIZED") @map("interview_mode")
  resumeQuestionsEnabled Boolean               @default(true) @map("resume_questions_enabled")
  focusPlans            InterviewFocusPlan[]
  companySkillBaselines CompanySkillBaseline[]
  interviewConfigs      InterviewConfig[]
  interviews            Interview[]
  questionnaire         JobQuestionnaire?

  @@map("job_positions")
}

/// Job-level interview questionnaire (one per job). Role-agnostic: holds no
/// industry or profession specific structure.
model JobQuestionnaire {
  questionnaireId String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("questionnaire_id")
  organizationId  String                     @db.Uuid @map("organization_id")
  jobId           String                     @unique @db.Uuid @map("job_id")
  activeVersionId String?                    @db.Uuid @map("active_version_id")
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime                   @default(now()) @db.Timestamptz(6) @map("updated_at")
  job             JobPosition                @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  activeVersion   JobQuestionnaireVersion?   @relation("questionnaire_active_version", fields: [activeVersionId], references: [questionnaireVersionId], onDelete: SetNull)
  versions        JobQuestionnaireVersion[]  @relation("questionnaire_versions")

  @@index([organizationId])
  @@map("job_questionnaires")
}

/// A questionnaire version. Once FINALIZED it must never be mutated - a new
/// version is created instead, so historical interviews stay reproducible.
model JobQuestionnaireVersion {
  questionnaireVersionId   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("questionnaire_version_id")
  questionnaireId          String                      @db.Uuid @map("questionnaire_id")
  organizationId           String                      @db.Uuid @map("organization_id")
  versionNumber            Int                         @map("version_number")
  status                   String                      @default("DRAFT")
  generatedBy              String                      @default("AI") @map("generated_by")
  interviewMode            String                      @default("STANDARD") @map("interview_mode")
  targetQuestionCount      Int?                        @map("target_question_count")
  interviewDurationMinutes Int?                        @map("interview_duration_minutes")
  generationModel          String?                     @map("generation_model")
  generationMeta           Json                        @default("{}") @map("generation_meta")
  generationAttempts       Int                         @default(0) @map("generation_attempts")
  createdBy                String?                     @db.Uuid @map("created_by")
  createdAt                DateTime                    @default(now()) @db.Timestamptz(6) @map("created_at")
  finalizedBy              String?                     @db.Uuid @map("finalized_by")
  finalizedAt              DateTime?                   @db.Timestamptz(6) @map("finalized_at")
  /// The exact focus plan version that generated this questionnaire; NULL
  /// for questionnaires generated without a focus plan.
  focusPlanId              String?                     @db.Uuid @map("focus_plan_id")
  focusPlan                InterviewFocusPlan?         @relation(fields: [focusPlanId], references: [planId], onDelete: SetNull)
  questionnaire            JobQuestionnaire            @relation("questionnaire_versions", fields: [questionnaireId], references: [questionnaireId], onDelete: Cascade)
  activeFor                JobQuestionnaire[]          @relation("questionnaire_active_version")
  questions                JobQuestionnaireQuestion[]

  @@unique([questionnaireId, versionNumber])
  @@index([organizationId, status])
  @@map("job_questionnaire_versions")
}

/// A single question inside a version. `sourceType` and `competencyLabel` are
/// deliberately generic so the model works for any role in any industry.
model JobQuestionnaireQuestion {
  questionnaireQuestionId String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("questionnaire_question_id")
  questionnaireVersionId  String                  @db.Uuid @map("questionnaire_version_id")
  organizationId          String                  @db.Uuid @map("organization_id")
  questionOrder           Int                     @map("question_order")
  questionText            String                  @map("question_text")
  questionType            String?                 @map("question_type")
  sourceType              String                  @default("job") @map("source_type")
  competencyLabel         String?                 @map("competency_label")
  /// Primary focus area (interview_focus_areas.area_key) this question covers.
  focusAreaKey            String?                 @map("focus_area_key")
  targetSkillId           String?                 @db.Uuid @map("target_skill_id")
  difficultyLevel         Int                     @default(3) @map("difficulty_level")
  phaseHint               String                  @default("core") @map("phase_hint")
  allowFollowUp           Boolean                 @default(true) @map("allow_follow_up")
  isMandatory             Boolean                 @default(true) @map("is_mandatory")
  evaluationCriteria      String?                 @map("evaluation_criteria")
  origin                  String                  @default("AI")
  renderingMode           String?                 @map("rendering_mode")
  createdAt               DateTime                @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt               DateTime                @default(now()) @db.Timestamptz(6) @map("updated_at")
  version                 JobQuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [questionnaireVersionId], onDelete: Cascade)

  @@index([questionnaireVersionId, questionOrder])
  @@index([organizationId])
  @@map("job_questionnaire_questions")
}

/// Versioned Interview Focus plan for a job + interview stage. Drives which
/// competencies generated questions COVER; it is not a scoring weight.
/// DRAFT is editable; ACTIVE and SUPERSEDED are immutable (enforced by a
/// database trigger). Role-agnostic.
model InterviewFocusPlan {
  planId             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("plan_id")
  organizationId     String                    @db.Uuid @map("organization_id")
  jobId              String                    @db.Uuid @map("job_id")
  stageKey           String                    @default("primary") @map("stage_key")
  versionNumber      Int                       @map("version_number")
  status             String                    @default("DRAFT")
  origin             String                    @default("VERIS_RECOMMENDED")
  resumeEmphasis     String                    @default("STANDARD") @map("resume_emphasis")
  recommendationMeta Json                      @default("{}") @map("recommendation_meta")
  createdBy          String?                   @db.Uuid @map("created_by")
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime                  @default(now()) @db.Timestamptz(6) @map("updated_at")
  job                JobPosition               @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  areas              InterviewFocusArea[]
  questionnaireVersions JobQuestionnaireVersion[]

  @@unique([jobId, stageKey, versionNumber])
  @@index([organizationId])
  @@map("interview_focus_plans")
}

/// One competency inside a focus plan version.
model InterviewFocusArea {
  areaId         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("area_id")
  planId         String             @db.Uuid @map("plan_id")
  organizationId String             @db.Uuid @map("organization_id")
  areaKey        String             @map("area_key")
  label          String
  description    String?
  isCustom       Boolean            @default(false) @map("is_custom")
  sortOrder      Int                @map("sort_order")
  coverageWeight Int                @map("coverage_weight")
  /// Reserved; unused in this phase. Coverage is not scoring.
  scoringWeight  Int?               @map("scoring_weight")
  createdAt      DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  plan           InterviewFocusPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@unique([planId, areaKey])
  @@index([planId, sortOrder])
  @@index([organizationId])
  @@map("interview_focus_areas")
}

model ExperienceLevelPool {
  experienceLevelId Int    @id @db.SmallInt @map("experience_level_id")
  label             String

  @@map("experience_level_pool")
}

model CompanySkillBaseline {
  organizationId String      @db.Uuid @map("organization_id")
  jobId          String      @db.Uuid @map("job_id")
  skillDomain    String      @map("skill_domain")
  expectedLevel  Int         @map("expected_level")
  job            JobPosition @relation(fields: [jobId], references: [jobId])

  @@id([organizationId, jobId, skillDomain])
  @@map("company_skill_baseline")
}

model EvaluationTemplatePool {
  templateId           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("template_id")
  name                 String
  codingWeight         Int               @default(0) @map("coding_weight")
  verbalWeight         Int               @default(0) @map("verbal_weight")
  systemDesignWeight   Int               @default(0) @map("system_design_weight")
  totalDurationMinutes Int               @default(30) @map("total_duration_minutes")
  isActive             Boolean?          @default(true) @map("is_active")
  createdAt            DateTime?         @default(now()) @db.Timestamptz(6) @map("created_at")
  interviewConfigs     InterviewConfig[]

  @@map("evaluation_template_pool")
}

model InterviewConfig {
  interviewId          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("interview_id")
  jobId                String                 @db.Uuid @map("job_id")
  templateId           String                 @db.Uuid @map("template_id")
  codingWeight         Int?                   @map("coding_weight")
  verbalWeight         Int?                   @map("verbal_weight")
  systemDesignWeight   Int?                   @map("system_design_weight")
  totalDurationMinutes Int                    @map("total_duration_minutes")
  mode                 String                 @default("AI")
  isActive             Boolean?               @default(true) @map("is_active")
  createdAt            DateTime?              @default(now()) @db.Timestamptz(6) @map("created_at")
  job                  JobPosition            @relation(fields: [jobId], references: [jobId])
  template             EvaluationTemplatePool @relation(fields: [templateId], references: [templateId])

  @@map("interview_configs")
}

model User {
  userId          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("user_id")
  organizationId  String     @db.Uuid @map("organization_id")
  fullName        String?    @map("full_name")
  email           String     @unique
  role            UserRole
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  phone           String?
  passwordHash    String?    @map("password_hash")
  isEmailVerified Boolean?   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean?   @default(false) @map("is_phone_verified")
  lastLoginAt     DateTime?  @db.Timestamptz(6) @map("last_login_at")
  userTypeId      Int?       @db.SmallInt @map("user_type_id")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  teamRemovedAt   DateTime?  @db.Timestamptz(6) @map("team_removed_at")

  @@map("users")
}

model Permission {
  permissionCode String  @id @map("permission_code")
  description    String?

  @@map("permissions")
}

model RecruiterRolePool {
  recruiterRoleId Int     @id @db.SmallInt @map("recruiter_role_id")
  code            String?
  description     String?

  @@map("recruiter_role_pool")
}

model RecruiterProfile {
  recruiterId     String  @id @db.Uuid @map("recruiter_id")
  companyName     String? @map("company_name")
  recruiterRoleId Int?    @db.SmallInt @map("recruiter_role_id")
  organizationId  String? @db.Uuid @map("organization_id")

  @@index([organizationId, recruiterId, recruiterRoleId], map: "idx_recruiter_profiles_org_recruiter_role")
  @@map("recruiter_profiles")
}

model RolePermission {
  recruiterRoleId Int    @db.SmallInt @map("recruiter_role_id")
  permission      String

  @@id([recruiterRoleId, permission])
  @@index([recruiterRoleId, permission], map: "idx_role_permissions_role_permission")
  @@map("role_permissions")
}

model RecruiterUserPermissionOverride {
  organizationId String   @db.Uuid @map("organization_id")
  userId         String   @db.Uuid @map("user_id")
  permissionCode String   @map("permission_code")
  isGranted      Boolean  @map("is_granted")
  updatedBy      String?  @db.Uuid @map("updated_by")
  updatedAt      DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")

  @@id([organizationId, userId, permissionCode])
  @@index([userId, organizationId], map: "idx_recruiter_user_permission_overrides_user")
  @@map("recruiter_user_permission_overrides")
}

/// Employee Assessments/Challenges/Tasks. Deliberately NOT a Candidate and
/// NOT a User/organization_memberships row: candidates have no login by
/// design (see auth's identity split), and organization_memberships is a
/// staff-role table (RECRUITER/ORG_OWNER/ADMIN/INTERVIEWER/SYSTEM) that must
/// stay staff-only. An employee is a third, independent participant type,
/// scoped by plain organizationId like every other model here. No login
/// identity is linked yet (MVP participation is invite-token only, mirroring
/// how candidates already take assessments with no login) — see
/// employee_identity_links note in the implementation report for the future
/// phase where employee self-service login is added.
model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  organizationId String   @db.Uuid @map("organization_id")
  fullName       String   @map("full_name")
  email          String
  managerUserId  String?  @db.Uuid @map("manager_user_id")
  department     String?
  title          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")

  @@unique([organizationId, email], map: "uq_employees_org_email")
  @@index([organizationId], map: "employees_organization_id_idx")
  @@index([managerUserId], map: "employees_manager_user_id_idx")
  @@map("employees")
}

model Candidate {
  candidateId     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("candidate_id")
  organizationId  String      @db.Uuid @map("organization_id")
  fullName        String      @map("full_name")
  email           String
  phone           String?
  status          String?
  resumeUrl       String?     @map("resume_url")
  resumeText      String?     @map("resume_text")
  createdAt       DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  interviews      Interview[]

  @@map("candidates")
}

model Interview {
  interviewId       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("interview_id")
  organizationId    String            @db.Uuid @map("organization_id")
  jobId             String            @db.Uuid @map("job_id")
  candidateId       String            @db.Uuid @map("candidate_id")
  interviewType     String            @map("interview_type")
  createdBy         String?           @db.Uuid @map("created_by")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  durationMinutes   Int?              @default(30) @map("duration_minutes")
  questionCount     Int?              @default(10) @map("question_count")
  aiStrictness      String?           @default("MEDIUM") @map("ai_strictness")
  resumeAiEnabled   Boolean?          @default(true) @map("resume_ai_enabled")
  maxAttempts       Int?              @default(2) @map("max_attempts")
  recoveryAllowed   Boolean           @default(true) @map("recovery_allowed")
  recoveryUsed      Boolean           @default(false) @map("recovery_used")
  finalStatus       String?           @map("final_status")
  forensicTimelineId String?          @db.Uuid @map("forensic_timeline_id")
  proctoringEnabled Boolean?          @default(true) @map("proctoring_enabled")
  status            String?           @map("status")
  questionStatus    String?           @default("PENDING") @map("question_status")
  emailStatus       String?           @default("PENDING") @map("email_status")
  failureReason     String?           @map("failure_reason")
  lastError         String?           @map("last_error")
  questionsGeneratedAt DateTime?      @db.Timestamptz(6) @map("questions_generated_at")
  questionnaireVersionId String?      @db.Uuid @map("questionnaire_version_id")
  questionnaireSnapshotAt DateTime?   @db.Timestamptz(6) @map("questionnaire_snapshot_at")
  emailSentAt       DateTime?         @db.Timestamptz(6) @map("email_sent_at")
  idempotencyKey    String?           @map("idempotency_key")
  candidateFeedbackText       String?   @map("candidate_feedback_text")
  candidateFeedbackStatus     String?   @map("candidate_feedback_status")
  candidateFeedbackGeneratedAt DateTime? @db.Timestamptz(6) @map("candidate_feedback_generated_at")
  candidateFeedbackSentAt     DateTime? @db.Timestamptz(6) @map("candidate_feedback_sent_at")
  candidateFeedbackSentTo     String?   @map("candidate_feedback_sent_to")
  candidateFeedbackHiringDecision String? @map("candidate_feedback_hiring_decision")
  candidateFeedbackGenerationAttempts Int @default(0) @map("candidate_feedback_generation_attempts")
  job               JobPosition       @relation(fields: [jobId], references: [jobId])
  candidate         Candidate         @relation(fields: [candidateId], references: [candidateId])
  attempts          InterviewAttempt[]
  interviewInvites  InterviewInvite[]
  recoveryEvents    InterviewRecoveryEvent[]

  @@unique([organizationId, idempotencyKey])
  @@map("interviews")
}

model InterviewAttempt {
  attemptId     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("attempt_id")
  interviewId   String               @db.Uuid @map("interview_id")
  attemptNumber Int                  @map("attempt_number")
  startedAt     DateTime             @default(now()) @db.Timestamptz(6) @map("started_at")
  endedAt       DateTime?            @db.Timestamptz(6) @map("ended_at")
  status        String               @map("status")
  interruptionReason String?          @map("interruption_reason")
  interruptionDetectedAt DateTime?    @db.Timestamptz(6) @map("interruption_detected_at")
  completionPercentage Decimal?       @db.Decimal(6, 4) @map("completion_percentage")
  transcriptStatus String             @default("PENDING") @map("transcript_status")
  recordingStatus String              @default("PENDING") @map("recording_status")
  timerRemainingSeconds Int?          @map("timer_remaining_seconds")
  inheritedFromAttemptId String?      @db.Uuid @map("inherited_from_attempt_id")
  recoveryLinkIssuedAt DateTime?      @db.Timestamptz(6) @map("recovery_link_issued_at")
  recoveryLinkExpiresAt DateTime?     @db.Timestamptz(6) @map("recovery_link_expires_at")
  recoveryDecision String?            @map("recovery_decision")
  recoveryDecidedBy String?           @db.Uuid @map("recovery_decided_by")
  recoveryDecidedAt DateTime?         @db.Timestamptz(6) @map("recovery_decided_at")
  recoveryTokenHash String?           @map("recovery_token_hash")
  recoveryTokenUsedAt DateTime?       @db.Timestamptz(6) @map("recovery_token_used_at")
  recoveryPolicy Json                 @default("{}") @map("recovery_policy")
  interview     Interview            @relation(fields: [interviewId], references: [interviewId])
  evaluation    InterviewEvaluation?
  inheritedFrom InterviewAttempt?     @relation("attempt_recovery_parent", fields: [inheritedFromAttemptId], references: [attemptId])
  recoveryAttempts InterviewAttempt[] @relation("attempt_recovery_parent")
  recoveryEvents InterviewRecoveryEvent[]
  inheritedRecoveryEvents InterviewRecoveryEvent[] @relation("recovery_event_inherited_from")

  @@map("interview_attempts")
}

model InterviewRecoveryEvent {
  recoveryEventId String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("recovery_event_id")
  interviewId     String            @db.Uuid @map("interview_id")
  attemptId       String?           @db.Uuid @map("attempt_id")
  inheritedFromAttemptId String?    @db.Uuid @map("inherited_from_attempt_id")
  eventType       String            @map("event_type")
  classifier      String?
  reason          String?
  source          String            @default("system")
  idempotencyKey  String?           @map("idempotency_key")
  occurredAt      DateTime          @default(now()) @db.Timestamptz(6) @map("occurred_at")
  actorId         String?           @db.Uuid @map("actor_id")
  metadata        Json              @default("{}")
  interview       Interview         @relation(fields: [interviewId], references: [interviewId])
  attempt         InterviewAttempt? @relation(fields: [attemptId], references: [attemptId])
  inheritedFrom   InterviewAttempt? @relation("recovery_event_inherited_from", fields: [inheritedFromAttemptId], references: [attemptId])

  @@map("interview_recovery_events")
}

model InterviewEvaluation {
  evaluationId String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("evaluation_id")
  attemptId    String           @unique @db.Uuid @map("attempt_id")
  finalScore   Decimal?         @db.Decimal @map("final_score")
  decision     String?
  aiSummary    String?          @map("ai_summary")
  createdAt    DateTime?        @default(now()) @db.Timestamptz(6) @map("created_at")
  isLocked     Boolean?         @default(true) @map("is_locked")
  attempt      InterviewAttempt @relation(fields: [attemptId], references: [attemptId])

  @@map("interview_evaluations")
}
model InterviewInvite {
  inviteId      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("invite_id")
  interviewId   String?    @db.Uuid @map("interview_id")
  token         String     @unique
  usedAt        DateTime?  @db.Timestamptz(6) @map("used_at")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  expiresAt     DateTime?  @db.Timestamptz(6) @map("expires_at")
  maxAttempts   Int?       @default(1) @map("max_attempts")
  attemptsUsed  Int?       @default(0) @map("attempts_used")
  status        String?    @default("ACTIVE")
  issuedBy      String?    @db.Uuid @map("issued_by")
  accessType    String?    @default("FLEXIBLE") @map("access_type")
  startTime     DateTime?  @db.Timestamptz(6) @map("start_time")
  endTime       DateTime?  @db.Timestamptz(6) @map("end_time")
  updatedAt     DateTime   @default(now()) @db.Timestamptz(6) @map("updated_at")
  revokedAt     DateTime?  @db.Timestamptz(6) @map("revoked_at")
  revokedReason String?    @map("revoked_reason")
  interview     Interview? @relation(fields: [interviewId], references: [interviewId])

  @@map("interview_invites")
}

model Plan {
  id               String   @id
  name             String
  slug             String   @unique
  price            Int
  priceInr         Int      @map("price_inr")
  priceUsd         Int      @map("price_usd")
  priceGbp         Int?     @map("price_gbp")
  priceEur         Int?     @map("price_eur")
  interviewLimit   Int
  screeningCredits Int      @default(0)
  assessmentCredits Int     @default(0)
  planType         String   @default("INTERVIEW")
  description      String?
  features         Json     @default("[]")
  order            Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, order], map: "hireveri_plans_active_order_idx")
  @@map("verisnova_plans")
}

model Coupon {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique
  description        String?
  discountPercentage Decimal   @db.Decimal(5, 2) @map("discount_percentage")
  maxGlobalUses      Int?      @map("max_global_uses")
  currentGlobalUses  Int       @default(0) @map("current_global_uses")
