/// VERIS Assessment. Independent of Screening/AI Interview; connects to the
/// existing hiring context only via jobId/candidateId/organizationId (plain
/// scalar FKs, not Prisma relations, so this never requires touching
/// JobPosition/Candidate/Organization/Interview*). Owned by the recruiter-
/// dashboard app for CRUD; the separate `assessment` app writes attempts/
/// answers/results/signals during a live candidate session.
///
/// Extended (Employee Assessments/Challenges/Tasks) with activityType and
/// participantType so the same pipeline serves both pre-hire candidates and
/// existing employees — see AssessmentInvite/AssessmentAttempt/
/// AssessmentResult.employeeId below. Both new columns default to the
/// pre-existing candidate behavior, so every row/query written before this
/// change keeps behaving identically.
model Assessment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @db.Uuid @map("organization_id")
  // Nullable: required for CANDIDATE-participant activities (which job is
  // this for?), optional for EMPLOYEE-participant activities — an employee
  // activity assesses an existing employee's knowledge/skill/ability, not
  // fit for a specific open job. When set on an employee activity, it's
  // optional context (e.g. a target role for future internal mobility),
  // never a requirement to create the activity. See lib/server/assessment/
  // validators.ts for the participantType-conditional requirement.
  jobId              String?             @db.Uuid @map("job_id")
  title              String
  description        String?
  durationMinutes    Int                 @default(30) @map("duration_minutes")
  passingPercentage  Decimal             @default(60) @db.Decimal(5, 2) @map("passing_percentage")
  questionCount      Int?                @map("question_count")
  difficulty         String?
  questionTypes      String[]            @default([]) @map("question_types")
  randomizeQuestions Boolean             @default(false) @map("randomize_questions")
  randomizeOptions   Boolean             @default(false) @map("randomize_options")
  linkExpiryDays     Int                 @default(7) @map("link_expiry_days")
  status             String              @default("DRAFT")
  settings           Json                @default("{}")
  activeVersionId    String?             @db.Uuid @map("active_version_id")
  createdBy          String?             @db.Uuid @map("created_by")
  createdAt          DateTime            @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime            @default(now()) @db.Timestamptz(6) @map("updated_at")
  // ASSESSMENT | CHALLENGE | TASK — product/UI distinction only; all three
  // share this exact persistence pipeline.
  activityType       String              @default("ASSESSMENT") @map("activity_type")
  // CANDIDATE | EMPLOYEE — who this activity is for.
  participantType    String              @default("CANDIDATE") @map("participant_type")
  // Free-form skill/topic tags for Challenges/Tasks; optional everywhere.
  skills             String[]            @default([])
  versions           AssessmentVersion[] @relation("assessment_versions")
  invites            AssessmentInvite[]
  attempts           AssessmentAttempt[]
  results            AssessmentResult[]

  @@index([organizationId], map: "assessments_organization_id_idx")
  @@index([jobId], map: "assessments_job_id_idx")
  @@index([status], map: "assessments_status_idx")
  @@index([organizationId, activityType, participantType], map: "assessments_org_activity_participant_idx")
  @@map("assessments")
}

model AssessmentVersion {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId      String               @db.Uuid @map("assessment_id")
  versionNumber     Int                  @map("version_number")
  status            String               @default("DRAFT")
  generationModel   String?              @map("generation_model")
  generationMeta    Json                 @default("{}") @map("generation_meta")
  generationAttempts Int                 @default(0) @map("generation_attempts")
  createdAt         DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  assessment        Assessment           @relation("assessment_versions", fields: [assessmentId], references: [id])
  questions         AssessmentQuestion[]
  invites           AssessmentInvite[]
  attempts          AssessmentAttempt[]

  @@unique([assessmentId, versionNumber])
  @@index([assessmentId], map: "assessment_versions_assessment_id_idx")
  @@map("assessment_versions")
}

model AssessmentQuestion {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId    String                       @db.Uuid @map("version_id")
  questionType String                       @map("question_type")
  questionText String                       @map("question_text")
  points       Decimal                      @default(1) @db.Decimal(6, 2)
  orderIndex   Int                          @default(0) @map("order_index")
  required     Boolean                      @default(true)
  rubric       Json?
  explanation  String?
  origin       String                       @default("AI")
  createdAt    DateTime                     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime                     @default(now()) @db.Timestamptz(6) @map("updated_at")
  version      AssessmentVersion            @relation(fields: [versionId], references: [id])
  options      AssessmentQuestionOption[]
