  @@index([versionId], map: "assessment_questions_version_id_idx")
  @@map("assessment_questions")
}

model AssessmentQuestionOption {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId  String             @db.Uuid @map("question_id")
  optionText  String             @map("option_text")
  optionOrder Int                @default(0) @map("option_order")
  isCorrect   Boolean            @default(false) @map("is_correct")
  question    AssessmentQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId], map: "assessment_question_options_question_id_idx")
  @@map("assessment_question_options")
}

model AssessmentInvite {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String              @db.Uuid @map("assessment_id")
  versionId      String              @db.Uuid @map("version_id")
  jobId          String?             @db.Uuid @map("job_id")
  // Nullable: exactly one of candidateId/employeeId is set, matching the
  // parent Assessment.participantType. candidateId's own semantics/behavior
  // for the existing candidate flow are unchanged — only the NOT NULL
  // constraint was loosened so an employee-participant row can omit it.
  candidateId    String?             @db.Uuid @map("candidate_id")
  employeeId     String?             @db.Uuid @map("employee_id")
  organizationId String              @db.Uuid @map("organization_id")
  tokenHash      String              @unique @map("token_hash")
  status         String              @default("INVITED")
  expiresAt      DateTime            @db.Timestamptz(6) @map("expires_at")
  sentAt         DateTime?           @db.Timestamptz(6) @map("sent_at")
  openedAt       DateTime?           @db.Timestamptz(6) @map("opened_at")
  completedAt    DateTime?           @db.Timestamptz(6) @map("completed_at")
  createdBy      String?             @db.Uuid @map("created_by")
  createdAt      DateTime            @default(now()) @db.Timestamptz(6) @map("created_at")
  assessment     Assessment          @relation(fields: [assessmentId], references: [id])
  version        AssessmentVersion   @relation(fields: [versionId], references: [id])
  attempt        AssessmentAttempt?

  @@index([organizationId], map: "assessment_invites_organization_id_idx")
  @@index([jobId], map: "assessment_invites_job_id_idx")
  @@index([candidateId], map: "assessment_invites_candidate_id_idx")
  @@index([employeeId], map: "assessment_invites_employee_id_idx")
  @@index([status], map: "assessment_invites_status_idx")
  @@map("assessment_invites")
}

model AssessmentAttempt {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteId        String             @unique @db.Uuid @map("invite_id")
  assessmentId    String             @db.Uuid @map("assessment_id")
  versionId       String             @db.Uuid @map("version_id")
  jobId           String?            @db.Uuid @map("job_id")
  candidateId     String?            @db.Uuid @map("candidate_id")
  employeeId      String?            @db.Uuid @map("employee_id")
  organizationId  String             @db.Uuid @map("organization_id")
  startedAt       DateTime?          @db.Timestamptz(6) @map("started_at")
  endsAt          DateTime?          @db.Timestamptz(6) @map("ends_at")
  submittedAt     DateTime?          @db.Timestamptz(6) @map("submitted_at")
  timedOutAt      DateTime?          @db.Timestamptz(6) @map("timed_out_at")
  status          String             @default("NOT_STARTED")
  objectiveScore  Decimal?           @db.Decimal(8, 2) @map("objective_score")
  subjectiveScore Decimal?           @db.Decimal(8, 2) @map("subjective_score")
  score           Decimal?           @db.Decimal(8, 2)
  maxScore        Decimal?           @db.Decimal(8, 2) @map("max_score")
  percentage      Decimal?           @db.Decimal(5, 2)
  passed          Boolean?
  creditDeducted  Boolean            @default(false) @map("credit_deducted")
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime           @default(now()) @db.Timestamptz(6) @map("updated_at")
  assessment      Assessment         @relation(fields: [assessmentId], references: [id])
  version         AssessmentVersion  @relation(fields: [versionId], references: [id])
  invite          AssessmentInvite   @relation(fields: [inviteId], references: [id])
  answers         AssessmentAnswer[]
  signals         AssessmentSignal[]
  result          AssessmentResult?

  @@index([assessmentId], map: "assessment_attempts_assessment_id_idx")
  @@index([candidateId], map: "assessment_attempts_candidate_id_idx")
  @@index([employeeId], map: "assessment_attempts_employee_id_idx")
  @@index([organizationId], map: "assessment_attempts_organization_id_idx")
  @@index([status], map: "assessment_attempts_status_idx")
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String                       @db.Uuid @map("attempt_id")
  questionId        String                       @db.Uuid @map("question_id")
  answer            Json                         @default("{}")
  answeredAt        DateTime                     @default(now()) @db.Timestamptz(6) @map("answered_at")
  timeSpentSeconds  Int?                         @map("time_spent_seconds")
  attempt           AssessmentAttempt            @relation(fields: [attemptId], references: [id])
  question          AssessmentQuestion           @relation(fields: [questionId], references: [id])
  evaluation        AssessmentAnswerEvaluation?

  @@unique([attemptId, questionId])
  @@index([attemptId], map: "assessment_answers_attempt_id_idx")
  @@map("assessment_answers")
}

model AssessmentAnswerEvaluation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId     String           @unique @db.Uuid @map("answer_id")
  score        Decimal?         @db.Decimal(6, 2)
  maxScore     Decimal?         @db.Decimal(6, 2) @map("max_score")
  feedback     String?
  rubricResult Json?            @map("rubric_result")
  provider     String?
  model        String?
  status       String           @default("PENDING")
  evaluatedAt  DateTime?        @db.Timestamptz(6) @map("evaluated_at")
  createdAt    DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  // Manager-review fields. AI evaluation above (score/feedback/provider/
  // model) is never overwritten by a manager review — a manager's score and
  // feedback are stored separately here so both are visible at once and the
  // original AI evaluation is preserved as an audit trail. evaluatorType
  // flips to "MANAGER" only once a manager has actually submitted a review
  // (default "AI" otherwise, matching current/candidate behavior exactly).
  evaluatorType      String    @default("AI") @map("evaluator_type")
  evaluatorUserId    String?   @db.Uuid @map("evaluator_user_id")
  managerScore       Decimal?  @db.Decimal(6, 2) @map("manager_score")
  managerFeedback    String?   @map("manager_feedback")
  managerEvaluatedAt DateTime? @db.Timestamptz(6) @map("manager_evaluated_at")
  answer       AssessmentAnswer @relation(fields: [answerId], references: [id])

  @@map("assessment_answer_evaluations")
}

model AssessmentResult {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId       String            @unique @db.Uuid @map("attempt_id")
  assessmentId    String            @db.Uuid @map("assessment_id")
  jobId           String?           @db.Uuid @map("job_id")
  candidateId     String?           @db.Uuid @map("candidate_id")
  employeeId      String?           @db.Uuid @map("employee_id")
  organizationId  String            @db.Uuid @map("organization_id")
  objectiveScore  Decimal?          @db.Decimal(8, 2) @map("objective_score")
  subjectiveScore Decimal?          @db.Decimal(8, 2) @map("subjective_score")
  totalScore      Decimal?          @db.Decimal(8, 2) @map("total_score")
  maxScore        Decimal?          @db.Decimal(8, 2) @map("max_score")
  percentage      Decimal?          @db.Decimal(5, 2)
  passed          Boolean?
  riskLevel       String?           @map("risk_level")
  summary         Json              @default("{}")
  completedAt     DateTime?         @db.Timestamptz(6) @map("completed_at")
  createdAt       DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  assessment      Assessment        @relation(fields: [assessmentId], references: [id])
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id])

  @@index([organizationId], map: "assessment_results_organization_id_idx")
  @@index([jobId], map: "assessment_results_job_id_idx")
  @@index([candidateId], map: "assessment_results_candidate_id_idx")
  @@index([employeeId], map: "assessment_results_employee_id_idx")
  @@map("assessment_results")
}

model AssessmentSignal {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId String            @db.Uuid @map("attempt_id")
  type      String
  value     Json              @default("{}")
  createdAt DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId], map: "assessment_signals_attempt_id_idx")
  @@map("assessment_signals")
}

model AssessmentCreditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid @map("organization_id")
  kind           String   @default("ASSESSMENT")
  amount         Int
  source         String?
  sourceId       String?  @map("source_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([organizationId], map: "assessment_credit_events_organization_id_idx")
  @@map("assessment_credit_events")
}

/// Idempotency cache for AI question-generation requests (interview
/// questionnaire + assessment). entityId is the stable questionnaire_id /
/// assessment_id, not the version, so a retry resolves to the same result
/// even if the first attempt forked a new draft version.
model AiGenerationIdempotency {
  entityType      String   @map("entity_type")
  entityId        String   @db.Uuid @map("entity_id")
  idempotencyKey  String   @map("idempotency_key")
  result          Json
  createdAt       DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@id([entityType, entityId, idempotencyKey])
  @@map("ai_generation_idempotency")
}










